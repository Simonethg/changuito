{
  "name": "@changuito/mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MCP server to search Argentine supermarket catalogs, build a cart in your own logged-in session, and pay with an ephemeral crypto-funded virtual card.",
  "bin": {
    "supermercado-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "pretest": "tsc",
    "test": "node --test dist/test/*.test.js",
    "smoke": "node --env-file-if-exists=.env dist/smoke.js",
    "dryrun": "node --env-file-if-exists=.env dist/dryrun.js",
    "record": "node --env-file-if-exists=.env dist/record.js",
    "keystore": "node --env-file-if-exists=.env dist/keystore-cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "ethers": "^6.13.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./orderform": {
      "types": "./dist/orderform.d.ts",
      "import": "./dist/orderform.js"
    },
    "./money": {
      "types": "./dist/util/money.d.ts",
      "import": "./dist/util/money.js"
    },
    "./fx": {
      "types": "./dist/pay/fx.d.ts",
      "import": "./dist/pay/fx.js"
    },
    "./pay": {
      "types": "./dist/pay/vyrion.d.ts",
      "import": "./dist/pay/vyrion.js"
    },
    "./card": {
      "types": "./dist/pay/ephemeral-card.d.ts",
      "import": "./dist/pay/ephemeral-card.js"
    }
  },
  "files": [
    "dist",
    "SETUP.md",
    "README.md",
    "VENDORED.md"
  ]
}
